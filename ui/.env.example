# Copia in ui/.env.local (gitignored) e compila con i valori del tuo progetto Supabase
# (Project Settings → API). La anon key è pubblica per design: i dati sono protetti da RLS.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Basemap (opzionale): di default le mappe usano tile OSM standard SENZA chiave,
# rese scure via filtro CSS. Per una basemap dark nativa (CARTO/MapTiler/Stadia)
# incolla qui l'URL template con la tua api key: verrà usata SENZA filtro invert.
# VITE_BASEMAP_URL=https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png?api_key=...
# VITE_BASEMAP_ATTRIBUTION=&copy; OpenStreetMap &copy; CARTO
